# Signing secret for your webhook endpoint.
#  - Demo / simulator: any string that starts with whsec_ works.
#  - Stripe CLI: paste the whsec_... that `stripe listen` prints.
#  - Real endpoint: Stripe Dashboard > Developers > Webhooks > your endpoint > Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_demo_local_secret

# Optional. Slack incoming webhook (api.slack.com/apps > Incoming Webhooks).
# Leave empty to see a Slack preview on the dashboard instead.
SLACK_WEBHOOK_URL=

# Optional. Google Apps Script web app URL (see integrations/google_sheets.gs).
# Leave empty to keep rows in the local ledger only (download as CSV).
SHEETS_WEBHOOK_URL=

BUSINESS_NAME=Three Rivers Wheel & Tire
